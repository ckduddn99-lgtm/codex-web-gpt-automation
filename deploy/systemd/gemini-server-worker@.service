[Unit]
Description=Antigravity Gemini worker for the sealed AI bus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
Environment=HOME=/home/%i
Environment=PATH=/home/%i/.local/bin:/snap/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /home/%i/codex-web-gpt-automation/bin/agy_server_worker.py --db /home/%i/.local/state/ai-bus/bus.sqlite3 --recipient gemini --worker-id gemini-antigravity --agy /home/%i/.local/bin/agy --serve --interval 5
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
