[Unit]
Description=Local-only noVNC web client for Oracle browser login
Requires=oracle-vnc@%i.service
After=oracle-vnc@%i.service

[Service]
Type=simple
User=%i
Environment=HOME=/home/%i
ExecStart=/usr/bin/websockify --web /usr/share/novnc 127.0.0.1:6080 127.0.0.1:5900
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
